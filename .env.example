# ==============================================================================
# Content Automation Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env (Linux/macOS)
#   copy .env.example .env (Windows)
# ==============================================================================

# --- AI API Configuration ---
# Your Anthropic or Anthropic-compatible API key (Required for AI generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Base URL for the Anthropic Messages API.
# Use https://api.anthropic.com for official Anthropic,
# or your local LLM proxy / gateway (e.g., http://localhost:20128/v1)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model to use for generation (e.g., claude-sonnet-4-6, claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Maximum concurrent requests to the AI API to respect rate limits
MAX_CONCURRENT_REQUESTS=3


# --- Storage & Paths ---
# Directory where generated content packages (scripts, titles, prompts) are exported.
# Defaults to a portable './output' folder in the repository root if left empty.
OUTPUT_DIR=./output

# Path to the persistent SQLite database for tracking generated ideas & batches.
# Defaults to './ideas.db' in the repository root if left empty.
DATABASE_PATH=./ideas.db

# Path to the presets registry JSON file.
# Defaults to the bundled presets './presets/master_presets_registry.json'.
MASTER_PRESETS_PATH=./presets/master_presets_registry.json

# Optional: Semicolon or comma-separated list of additional directories to scan
# for historical project folders to prevent topic repetition (e.g., /path/to/old_content)
# IDEA_SCAN_DIRS=

# Optional: Parent root directory containing sibling automation workspaces
# (used by auxiliary maintenance scripts)
# AUTOMATION_ROOT=
